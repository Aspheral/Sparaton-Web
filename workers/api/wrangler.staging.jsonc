{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sparaton-api-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sparaton-staging",
      "database_id": "REPLACE_WITH_STAGING_D1_DATABASE_ID",
      "migrations_dir": "../../packages/database/migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "TICKET_ROOMS", "class_name": "TicketRoom" }
    ]
  },
  "r2_buckets": [
    { "binding": "ATTACHMENTS", "bucket_name": "sparaton-staging-private-attachments" },
    { "binding": "CMS_MEDIA", "bucket_name": "sparaton-staging-public-media" }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TicketRoom"] }
  ],
  "vars": {
    "DEPLOYMENT_ENV": "staging",
    "STUDIOS_ORIGIN": "REPLACE_WITH_STAGING_STUDIOS_ORIGIN",
    "ADMIN_ORIGIN": "REPLACE_WITH_STAGING_ADMIN_ORIGIN",
    "EMAIL_DELIVERY_MODE": "disabled",
    "EMAIL_FROM_NOTIFICATIONS": "Sparaton Staging <notifications@staging.invalid>",
    "EMAIL_FROM_TICKETS": "Sparaton Staging <tickets@staging.invalid>"
  }
}
