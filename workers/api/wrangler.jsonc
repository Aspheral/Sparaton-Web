{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sparaton-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sparaton-production",
      "database_id": "REPLACE_WITH_CLOUDFLARE_D1_DATABASE_ID",
      "migrations_dir": "../../packages/database/migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "TICKET_ROOMS", "class_name": "TicketRoom" }
    ]
  },
  "r2_buckets": [
    { "binding": "ATTACHMENTS", "bucket_name": "sparaton-private-attachments" },
    { "binding": "CMS_MEDIA", "bucket_name": "sparaton-public-media" }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TicketRoom"] }
  ],
  "triggers": {
    "crons": ["17 */6 * * *"]
  },
  "vars": {
    "DEPLOYMENT_ENV": "production",
    "STUDIOS_ORIGIN": "https://sparaton.com",
    "ADMIN_ORIGIN": "https://admin.sparaton.com",
    "EMAIL_DELIVERY_MODE": "enabled",
    "EMAIL_FROM_NOTIFICATIONS": "Sparaton Studios <notifications@sparaton.com>",
    "EMAIL_FROM_TICKETS": "Sparaton Tickets <tickets@sparaton.com>"
  }
}
