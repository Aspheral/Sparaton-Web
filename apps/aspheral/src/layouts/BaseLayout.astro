---
import '@sparaton/ui/styles.css';
import brand from '@sparaton/ui/brand.svg?raw';
const { title='Aspheral Softworks', description='Software engineering, machine learning, research-oriented software, and unusual technical projects.', canonical=Astro.url.pathname, ogImage='/og/aspheral.svg' } = Astro.props;
const canonicalUrl=new URL(canonical,'https://aspheral.sparaton.com');const imageUrl=new URL(ogImage,'https://aspheral.sparaton.com');
const schema=JSON.stringify({'@context':'https://schema.org','@type':'Organization',name:'Aspheral Softworks',url:'https://aspheral.sparaton.com',parentOrganization:{'@type':'Organization',name:'Sparaton Studios',url:'https://sparaton.com'}});
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#151716"/><link rel="canonical" href={canonicalUrl}/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><meta property="og:type" content="website"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonicalUrl}/><meta property="og:image" content={imageUrl}/><meta property="og:site_name" content="Aspheral Softworks"/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={imageUrl}/><title>{title}</title><script is:inline>
(()=>{try{const saved=localStorage.getItem('sparaton-theme');const dark=matchMedia('(prefers-color-scheme: dark)').matches;document.documentElement.dataset.theme=saved==='light'||saved==='dark'?saved:dark?'dark':'light'}catch{}})();
</script><script is:inline type="application/ld+json" set:html={schema}></script></head><body><a class="skip-link" href="#content">Skip to content</a><header class="shell site-header"><a class="brand" href="/"><span set:html={brand}></span><span>ASPHERAL SOFTWORKS</span></a><nav class="nav"><a href="/#projects">Projects</a><a href="/#engineering">Engineering</a><a href="https://github.com/Aspheral">GitHub</a><a class="always" href="https://sparaton.com/contact?team=aspheral">Contact</a><button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle color theme">◐</button></nav></header><main id="content"><slot/></main><footer><div class="shell footer-grid"><div><a class="brand" href="/"><span set:html={brand}></span><span>ASPHERAL SOFTWORKS</span></a><p class="muted">A technical practice within the Sparaton ecosystem.</p></div><div><strong>Projects</strong><ul><li><a href="/projects/kay-chess">Kay Chess</a></li></ul></div><div><strong>Sparaton</strong><ul><li><a href="https://sparaton.com">Sparaton Studios</a></li><li><a href="https://ilmp.sparaton.com">ILMP / Lattice Forge</a></li></ul></div><div><strong>Social</strong><ul><li><a href="https://github.com/Aspheral">GitHub</a></li><li><a href="https://discord.com/users/886356555774193674">Discord</a></li></ul></div></div></footer><script is:inline>
document.getElementById('theme-toggle')?.addEventListener('click',()=>{const next=document.documentElement.dataset.theme==='dark'?'light':'dark';document.documentElement.dataset.theme=next;localStorage.setItem('sparaton-theme',next)});
</script></body></html>
