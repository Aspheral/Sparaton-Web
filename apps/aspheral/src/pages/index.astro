---
import BaseLayout from '../layouts/BaseLayout.astro';
import { kayChess } from '@sparaton/content';
---
<BaseLayout title="Aspheral Softworks | Engineering inside Sparaton">
<section class="shell hero"><div><p class="eyebrow">Aspheral Softworks · Sparaton</p><h1>Software for ideas that do not fit neatly in a product brief.</h1></div><div><p class="lede">Aspheral works across software engineering, machine learning, experimental technology, and research-oriented projects, with an emphasis on building first and making claims second.</p><a class="button" href="https://github.com/Aspheral">View GitHub →</a></div></section>
<section class="section" id="projects"><div class="shell"><div class="section-head"><p class="eyebrow">Featured project</p><h2>{kayChess.name}</h2></div><article class="card" style="min-height:27rem"><div><span class="pill">{kayChess.status.replace('-', ' ')}</span><h3 style="font-size:clamp(2.4rem,6vw,5.5rem);margin-top:1rem">A chess engine under active, measured development.</h3></div><div><p class="muted" style="max-width:56rem">{kayChess.summary} Current ratings shown on the project page are local estimates, and throughput is kept separate from playing-strength claims.</p><a class="button" href="/projects/kay-chess">Read the project record →</a></div></article></div></section>
<section class="dark-band" id="engineering"><div class="shell"><div class="section-head"><p class="eyebrow">Engineering practice</p><h2>Measure the experiment. Keep the rejection.</h2></div><div class="grid-3"><article class="card" style="background:var(--night);color:var(--night-ink)"><h3>Benchmarks with context</h3><p class="muted">Performance numbers are useful only when the hardware, settings, and meaning of the metric travel with them.</p></article><article class="card" style="background:var(--night);color:var(--night-ink)"><h3>Provisional means provisional</h3><p class="muted">Local Elo estimates and development screens are presented as evidence, not universal authority.</p></article><article class="card" style="background:var(--night);color:var(--night-ink)"><h3>Negative results stay useful</h3><p class="muted">Rejected ideas still improve tooling, test coverage, and the next experiment.</p></article></div></div></section>
</BaseLayout>
