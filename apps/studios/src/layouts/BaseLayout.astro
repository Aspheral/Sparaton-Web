---
import '@sparaton/ui/styles.css';
import brand from '@sparaton/ui/brand.svg?raw';
const {
  title = 'Sparaton Studios',
  description = 'Creative work built around the people who make it.',
  canonical = Astro.url.pathname,
  ogImage = '/og/sparaton.svg',
  ogType = 'website',
  robots = 'index,follow',
  schemas = []
} = Astro.props;
const canonicalUrl = new URL(canonical, 'https://sparaton.com');
const imageUrl = new URL(ogImage, 'https://sparaton.com');
const organizationSchema={ '@context':'https://schema.org', '@type':'Organization', name:'Sparaton Studios', url:'https://sparaton.com', founder:[{ '@type':'Person', name:'Rocko Sparacino' },{ '@type':'Person', name:'Koah Seaton' }] };
const jsonLd=JSON.stringify([organizationSchema,...schemas]);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#f4f0e7" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.svg" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:site_name" content="Sparaton Studios" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <title>{title}</title>
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('sparaton-theme');
          const dark = matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.dataset.theme = saved === 'light' || saved === 'dark' ? saved : dark ? 'dark' : 'light';
        } catch {}
      })();
    </script>
    <script is:inline type="application/ld+json" set:html={jsonLd}></script>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="shell site-header">
      <a class="brand" href="/" aria-label="Sparaton Studios home"><span set:html={brand}></span><span>SPARATON</span></a>
      <nav class="nav" aria-label="Primary">
        <a href="/services">Services</a><a href="/people">People</a><a href="/projects">Work</a><a href="/news">News</a><a class="always" href="/contact">Contact</a>
        <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle color theme">◐</button>
      </nav>
    </header>
    <main id="content"><slot /></main>
    <footer>
      <div class="shell footer-grid">
        <div><a class="brand" href="/"><span set:html={brand}></span><span>SPARATON</span></a><p class="muted">Creative and technical work, organized around the people who actually make it.</p></div>
        <div><strong>Studios</strong><ul><li><a href="https://aspheral.sparaton.com">Aspheral Softworks</a></li><li><a href="https://ilmp.sparaton.com">ILMP / Lattice Forge</a></li></ul></div>
        <div><strong>Resources</strong><ul><li><a href="/projects">Projects</a></li><li><a href="/people">People</a></li><li><a href="/services">Services</a></li><li><a href="/contact">Contact</a></li></ul></div>
        <div><strong>Trust</strong><ul><li><a href="/privacy">Privacy</a></li><li><a href="/terms">Terms</a></li><li><a href="/accessibility">Accessibility</a></li><li><a href="/responsible-disclosure">Responsible Disclosure</a></li></ul></div>
      </div>
    </footer>
    <script is:inline>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('sparaton-theme', next);
      });
    </script>
  </body>
</html>
