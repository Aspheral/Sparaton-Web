---
import BaseLayout from '../../layouts/BaseLayout.astro';
const { publicId } = Astro.params;
---
<BaseLayout title="Private ticket | Sparaton Studios" description="Private Sparaton ticket conversation." canonical={`/tickets/${publicId}`} robots="noindex,nofollow,noarchive">
  <section class="shell hero" style="padding-bottom:3rem">
    <div><p class="eyebrow">Private ticket</p><h1 style="font-size:clamp(3rem,7vw,6rem)">Conversation</h1></div>
    <div><p class="lede" id="ticket-subject">Loading your ticket…</p><span class="pill" id="connection">Connecting</span></div>
  </section>
  <section class="section"><div class="shell" style="max-width:64rem"><div id="error" role="alert" class="muted"></div><div id="timeline" aria-live="polite" style="display:grid;gap:1rem;margin-bottom:2rem"></div><section class="card" style="min-height:0;margin-bottom:1rem"><div class="section-head"><div><p class="eyebrow">Private files</p><h2 style="font-size:1.5rem">Attachments</h2></div><p class="muted">PDF, PNG, JPEG, GIF, WebP, TXT or Markdown. Maximum 10 MiB each.</p></div><div id="attachments" style="display:grid;gap:.5rem;margin-bottom:1rem"></div><form id="attachment-form" style="display:flex;gap:.75rem;align-items:end;flex-wrap:wrap"><label style="flex:1;min-width:15rem">Choose file<input name="file" type="file" required accept=".pdf,.png,.jpg,.jpeg,.gif,.webp,.txt,.md,application/pdf,image/png,image/jpeg,image/gif,image/webp,text/plain,text/markdown"/></label><button class="button" type="submit">Upload attachment</button></form></section><form id="reply-form" class="form-grid"><label>Reply<textarea name="body" maxlength="12000" required></textarea></label><button class="button" type="submit">Send reply →</button></form></div></section>
  <script is:inline define:vars={{ publicId }}>
    const api='https://api.sparaton.com';const timeline=document.getElementById('timeline'),error=document.getElementById('error'),subject=document.getElementById('ticket-subject'),connection=document.getElementById('connection'),attachments=document.getElementById('attachments');let csrf='';function renderMessage(m){if(document.getElementById(`m-${m.id}`))return;const el=document.createElement('article');el.id=`m-${m.id}`;el.className='card';el.style.minHeight='0';el.innerHTML='<div><span class="eyebrow"></span><p style="white-space:pre-wrap;margin-bottom:0"></p></div>';el.querySelector('.eyebrow').textContent=m.author_kind==='client'?'You':m.author_kind==='staff'?'Sparaton':'System';el.querySelector('p').textContent=m.body;timeline.appendChild(el)}function renderAttachments(items){attachments.replaceChildren();if(!items.length){const empty=document.createElement('p');empty.className='muted';empty.textContent='No attachments in this ticket.';attachments.appendChild(empty);return}for(const item of items){const row=document.createElement('div');row.style.cssText='display:flex;justify-content:space-between;gap:1rem;align-items:center;border-top:1px solid var(--line);padding:.65rem 0';const label=document.createElement('span');label.textContent=`${item.original_filename} · ${Math.ceil(item.byte_size/1024)} KiB`;const link=document.createElement('a');link.className='button';link.href=`${api}/v1/tickets/${publicId}/attachments/${encodeURIComponent(item.id)}`;link.textContent='Download';row.append(label,link);attachments.appendChild(row)}}async function loadAttachments(){const r=await fetch(`${api}/v1/tickets/${publicId}/attachments`,{credentials:'include'});if(!r.ok)return;const data=await r.json();renderAttachments(data.attachments||[])}async function load(){const r=await fetch(`${api}/v1/tickets/${publicId}`,{credentials:'include'});if(r.status===401){error.textContent='This ticket session is missing or expired. Return to Contact and use the same email address to receive a fresh secure link.';document.getElementById('reply-form').hidden=true;document.getElementById('attachment-form').hidden=true;return}if(!r.ok)throw new Error('Ticket unavailable');const data=await r.json();csrf=data.csrf;subject.textContent=data.ticket.subject;data.messages.forEach(renderMessage);await loadAttachments();if(!window.__sparatonSocket)connect()}function connect(){const ws=new WebSocket(`wss://api.sparaton.com/v1/tickets/${publicId}/socket`);window.__sparatonSocket=ws;ws.onopen=()=>connection.textContent='Live';ws.onclose=()=>{connection.textContent='Reconnecting…';window.__sparatonSocket=null;setTimeout(connect,3000)};ws.onerror=()=>connection.textContent='Connection interrupted';ws.onmessage=e=>{try{const event=JSON.parse(e.data);if(event.type==='message')renderMessage(event.message)}catch{}}}document.getElementById('reply-form').addEventListener('submit',async e=>{e.preventDefault();const form=e.currentTarget,body=new FormData(form).get('body'),r=await fetch(`${api}/v1/tickets/${publicId}/messages`,{method:'POST',credentials:'include',headers:{'content-type':'application/json','x-sparaton-csrf':csrf},body:JSON.stringify({body})});if(!r.ok){error.textContent=(await r.json()).error??'Could not send message';return}form.reset();await load()});document.getElementById('attachment-form').addEventListener('submit',async e=>{e.preventDefault();const form=e.currentTarget,data=new FormData(form),file=data.get('file');if(file instanceof File&&file.size>10*1024*1024){error.textContent='That attachment is larger than 10 MiB.';return}error.textContent='Uploading attachment…';const r=await fetch(`${api}/v1/tickets/${publicId}/attachments`,{method:'POST',credentials:'include',headers:{'x-sparaton-csrf':csrf},body:data});if(!r.ok){const payload=await r.json().catch(()=>({error:'Attachment upload failed'}));error.textContent=payload.error??'Attachment upload failed';return}form.reset();error.textContent='Attachment uploaded.';await loadAttachments()});load().catch(()=>{error.textContent='The ticket service is temporarily unavailable.';connection.textContent='Unavailable'});
  </script>
</BaseLayout>
