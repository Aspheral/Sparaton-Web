---
import BaseLayout from '../../layouts/BaseLayout.astro';
const { publicId }=Astro.params;
---
<BaseLayout title="Private ticket | Sparaton Studios" description="Private Sparaton ticket conversation." canonical={`/tickets/${publicId}`}>
<section class="shell hero" style="padding-bottom:3rem"><div><p class="eyebrow">Private ticket</p><h1 style="font-size:clamp(3rem,7vw,6rem)">Conversation</h1></div><div><p class="lede" id="ticket-subject">Loading your ticket…</p><span class="pill" id="connection">Connecting</span></div></section>
<section class="section"><div class="shell" style="max-width:64rem"><div id="error" role="alert" class="muted"></div><div id="timeline" aria-live="polite" style="display:grid;gap:1rem;margin-bottom:2rem"></div><form id="reply-form" class="form-grid"><label>Reply<textarea name="body" maxlength="12000" required></textarea></label><button class="button" type="submit">Send reply →</button></form></div></section>
<script define:vars={{publicId}}>
const api='https://api.sparaton.com';const timeline=document.getElementById('timeline');const error=document.getElementById('error');const subject=document.getElementById('ticket-subject');const connection=document.getElementById('connection');
function renderMessage(m){if(document.getElementById(`m-${m.id}`))return;const el=document.createElement('article');el.id=`m-${m.id}`;el.className='card';el.style.minHeight='0';el.innerHTML=`<div><span class="eyebrow">${m.author_kind==='client'?'You':m.author_kind==='staff'?'Sparaton':'System'}</span><p style="white-space:pre-wrap;margin-bottom:0"></p></div>`;el.querySelector('p').textContent=m.body;timeline.appendChild(el);}
async function load(){const r=await fetch(`${api}/v1/tickets/${publicId}`,{credentials:'include'});if(r.status===401){error.textContent='This ticket session is missing or expired. Return to Contact and use the same email address to receive a fresh secure link.';document.getElementById('reply-form').hidden=true;return;}if(!r.ok)throw new Error('Ticket unavailable');const data=await r.json();subject.textContent=data.ticket.subject;data.messages.forEach(renderMessage);connect();}
function connect(){const ws=new WebSocket(`wss://api.sparaton.com/v1/tickets/${publicId}/socket`);ws.onopen=()=>connection.textContent='Live';ws.onclose=()=>{connection.textContent='Offline';setTimeout(connect,3000)};ws.onmessage=e=>{try{const event=JSON.parse(e.data);if(event.type==='message')renderMessage(event.message)}catch{}};}
document.getElementById('reply-form').addEventListener('submit',async e=>{e.preventDefault();const form=e.currentTarget;const body=new FormData(form).get('body');const r=await fetch(`${api}/v1/tickets/${publicId}/messages`,{method:'POST',credentials:'include',headers:{'content-type':'application/json'},body:JSON.stringify({body})});if(!r.ok){error.textContent=(await r.json()).error??'Could not send message';return;}form.reset();await load();});
load().catch(()=>{error.textContent='The ticket service is temporarily unavailable.';connection.textContent='Unavailable'});
</script>
</BaseLayout>
