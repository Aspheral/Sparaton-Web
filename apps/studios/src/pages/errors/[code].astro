---
import BaseLayout from '../../layouts/BaseLayout.astro';
const requested=Number(Astro.params.code);const allowed=new Set([400,401,403,404,429,500,503]);const code=allowed.has(requested)?requested:404;Astro.response.status=code;
const copy:Record<number,{title:string;body:string}>={400:{title:'That request could not be used.',body:'Check the information you submitted and try again.'},401:{title:'Private access is required.',body:'This resource needs a valid secure session before it can be opened.'},403:{title:'This action is not permitted.',body:'Your current access does not allow this request.'},404:{title:'This path ends here.',body:'The page may have moved, been unpublished, or never existed.'},429:{title:'Too many requests.',body:'The service is protecting itself from unusually frequent requests. Try again later.'},500:{title:'Something failed on our side.',body:'The request reached Sparaton, but the service could not finish it safely.'},503:{title:'Temporarily unavailable.',body:'A required Sparaton service or configured provider is currently unavailable.'}};const current=copy[code];
---
<BaseLayout title={`${code} · Sparaton Studios`} description={current.body} robots="noindex,nofollow" canonical={`/errors/${code}`}><section class="shell hero"><div><p class="eyebrow">{code}</p><h1>{current.title}</h1></div><div><p class="lede">{current.body}</p><p><a class="button" href="/">Return to Sparaton</a> <a class="button" href="/contact">Contact</a></p></div></section></BaseLayout>
