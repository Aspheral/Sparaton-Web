---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fetchContent, markdownToSafeHtml } from '../../lib/public-content';
const slug=Astro.params.slug??'';const result=await fetchContent('posts',slug);if(result.status!==200)Astro.response.status=result.status===404?404:503;const item:any=result.item;const title=item?String(item.seo_title||item.title||'News'):'Article unavailable';const description=item?String(item.seo_description||item.summary||''):'This article could not be found.';const canonical=item?.canonical_url?String(item.canonical_url):`/news/${slug}`;const authors=Array.isArray(item?.authors)?item.authors:[];const schema=item?[{'@context':'https://schema.org','@type':'Article',headline:item.title,description:item.summary,datePublished:item.published_at,dateModified:item.updated_at,mainEntityOfPage:new URL(canonical,'https://sparaton.com').toString(),publisher:{'@type':'Organization',name:'Sparaton Studios',url:'https://sparaton.com'},author:authors.length?authors.map((a:any)=>({'@type':'Person',name:a.display_name,url:`https://sparaton.com/people/${a.slug}`})):{'@type':'Organization',name:item.organization_name||'Sparaton Studios'}},{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Sparaton Studios',item:'https://sparaton.com'},{'@type':'ListItem',position:2,name:'News',item:'https://sparaton.com/news'},{'@type':'ListItem',position:3,name:item.title,item:new URL(canonical,'https://sparaton.com').toString()}]}]:[];
---
<BaseLayout title={title} description={description} canonical={canonical} ogType="article" ogImage={item?.social_image_url||'/og/sparaton.svg'} robots={item&&Number(item.robots_index)===0?'noindex,nofollow':'index,follow'} schemas={schema}><article><header class="shell hero"><div><p class="eyebrow">{item?.type??'News'}</p><h1>{item?.title??'Article unavailable'}</h1></div><div><p class="lede">{item?.summary??'The requested article is not published or is temporarily unavailable.'}</p>{item&&<p class="muted">{item.published_at&&new Date(item.published_at).toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric'})}{authors.length>0&&` · ${authors.map((a:any)=>a.display_name).join(', ')}`}</p>}</div></header>{item&&<section class="section"><div class="shell" style="max-width:52rem"><div class="prose" set:html={markdownToSafeHtml(String(item.body_markdown||''))}></div>{item.project_slug&&<p style="margin-top:3rem"><a class="button" href={`/projects/${item.project_slug}`}>Related project: {item.project_name}</a></p>}</div></section>}</article></BaseLayout>
