---
import BaseLayout from '../../layouts/BaseLayout.astro';
type PublicPost = { slug:string; type:string; title:string; summary:string; published_at:string|null };
let posts:PublicPost[]=[];
let unavailable=false;
try {
  const response=await fetch('https://api.sparaton.com/v1/content/posts');
  if(response.ok){
    const payload=await response.json() as {posts?:PublicPost[]};
    posts=payload.posts??[];
  } else unavailable=true;
} catch { unavailable=true; }
---
<BaseLayout title="News | Sparaton Studios" description="Announcements, project updates, engineering notes, research, and studio news from Sparaton."><section class="shell hero"><div><p class="eyebrow">News / Devlog</p><h1>Work in motion.</h1></div><p class="lede">Announcements, research notes, project updates, and development records from across the Sparaton ecosystem.</p></section><section class="section"><div class="shell">{unavailable?<p class="muted">The publishing service is temporarily unavailable.</p>:posts.length===0?<p class="muted">No public posts have been published yet.</p>:<div class="grid-3">{posts.map(post=><article class="card"><div><span class="eyebrow">{post.type}</span><h3 style="margin-top:1rem">{post.title}</h3></div><div><p>{post.summary}</p>{post.published_at&&<time class="muted" datetime={post.published_at}>{new Date(post.published_at).toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric'})}</time>}</div></article>)}</div>}</div></section></BaseLayout>
