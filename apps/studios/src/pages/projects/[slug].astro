---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fetchContent, markdownToSafeHtml } from '../../lib/public-content';
const slug=Astro.params.slug??'';const result=await fetchContent('projects',slug);if(result.status!==200)Astro.response.status=result.status===404?404:503;const item=result.item;const title=item?String(item.seo_title||item.name||'Project'):'Project unavailable';const description=item?String(item.seo_description||item.summary||''):'This project could not be found.';const canonical=item&&item.canonical_url?String(item.canonical_url):`/projects/${slug}`;const metrics=item&&Array.isArray(item.metrics)?item.metrics:[];const people=item&&Array.isArray(item.people)?item.people:[];const relatedPosts=item&&Array.isArray(item.posts)?item.posts:[];const schema=item?[{'@context':'https://schema.org','@type':item.repository_url?'SoftwareApplication':'CreativeWork',name:item.name,description:item.summary,url:new URL(canonical,'https://sparaton.com').toString(),creator:people.map((p:any)=>({'@type':'Person',name:p.display_name,url:`https://sparaton.com/people/${p.slug}`}))},{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Sparaton Studios',item:'https://sparaton.com'},{'@type':'ListItem',position:2,name:'Projects',item:'https://sparaton.com/projects'},{'@type':'ListItem',position:3,name:item.name,item:new URL(canonical,'https://sparaton.com').toString()}]}]:[];
---
<BaseLayout title={title} description={description} canonical={canonical} ogImage={item?.social_image_url||'/og/sparaton.svg'} robots={item&&Number(item.robots_index)===0?'noindex,nofollow':'index,follow'} schemas={schema}><section class="shell hero"><div><p class="eyebrow">Project</p><h1>{item?.name??'Project unavailable'}</h1></div><p class="lede">{item?.summary??'The requested project is not published or is temporarily unavailable.'}</p></section>{item&&<><section class="section"><div class="shell"><div class="metric-grid"><div class="metric"><span class="eyebrow">Status</span><strong style="font-size:1.35rem">{item.status}</strong></div>{metrics.slice(0,5).map((metric:any)=><div class="metric"><span class="eyebrow">{metric.label}</span><strong style="font-size:1.35rem">{metric.value}</strong><span class="muted">{metric.qualifier||metric.status}</span></div>)}</div></div></section><section class="section"><div class="shell" style="display:grid;grid-template-columns:minmax(0,1.5fr) minmax(15rem,.5fr);gap:3rem"><article class="prose" set:html={markdownToSafeHtml(String(item.body_markdown||item.summary||''))}></article><aside><p class="eyebrow">Project links</p><ul>{item.repository_url&&<li><a href={item.repository_url}>View source</a></li>}{item.latest_release_url&&<li><a href={item.latest_release_url}>Latest GitHub release</a></li>}{item.documentation_url&&<li><a href={item.documentation_url}>Documentation</a></li>}</ul>{people.length>0&&<><p class="eyebrow">Creators</p><ul>{people.map((p:any)=><li><a href={`/people/${p.slug}`}>{p.display_name}</a> · {p.credit_label}</li>)}</ul></>}</aside></div></section>{relatedPosts.length>0&&<section class="section"><div class="shell"><div class="section-head"><p class="eyebrow">Development</p><h2>Related posts</h2></div><div class="grid-3">{relatedPosts.map((post:any)=><a class="card" href={`/news/${post.slug}`}><span class="eyebrow">{post.type}</span><h3>{post.title}</h3><p>{post.summary}</p></a>)}</div></div></section>}</>}</BaseLayout>
