---
import BaseLayout from '../../layouts/BaseLayout.astro';
let projects:any[]=[];let unavailable=false;try{const response=await fetch('https://api.sparaton.com/v1/content/projects');if(response.ok){const data=await response.json() as {projects:any[]};projects=data.projects}else unavailable=true}catch{unavailable=true}
---
<BaseLayout title="Projects · Sparaton Studios" description="Selected creative and technical projects across the Sparaton ecosystem." canonical="/projects"><section class="shell hero"><div><p class="eyebrow">Work</p><h1>Projects</h1></div><p class="lede">Creative, technical, experimental, and research work from people and organizations across Sparaton.</p></section><section class="section"><div class="shell">{unavailable&&<p class="muted">Project publishing is temporarily unavailable.</p>}{!unavailable&&projects.length===0&&<p class="muted">No public projects are currently published.</p>}<div class="grid-3">{projects.map(project=><a class="card" href={`/projects/${project.slug}`}><span class="eyebrow">{project.status}</span><h2 style="font-size:1.7rem">{project.name}</h2><p>{project.summary}</p>{project.organization_name&&<p class="muted">{project.organization_name}</p>}</a>)}</div></div></section></BaseLayout>
