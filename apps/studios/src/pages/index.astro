---
import creators from '../data/creators.json';

// Public search signals belong to sparaton.com, never to the temporary preview.
const siteUrl = 'https://sparaton.com/';
const siteTitle = 'Sparaton | Independent Manga Production Studio';
const siteDescription = 'Sparaton is an independent manga production studio developing original stories, characters, and worlds. Meet our creators and contact the studio.';
const robots = Astro.url.hostname === 'sparaton.com' ? 'index,follow,max-image-preview:large' : 'noindex,follow';
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': siteUrl + '#organization',
      name: 'Sparaton',
      url: siteUrl,
      description: siteDescription,
      logo: siteUrl + 'favicon.png',
      email: 'support@sparaton.com',
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'general inquiries',
        email: 'support@sparaton.com'
      }
    },
    {
      '@type': 'WebSite',
      '@id': siteUrl + '#website',
      name: 'Sparaton',
      url: siteUrl,
      description: siteDescription,
      publisher: { '@id': siteUrl + '#organization' },
      inLanguage: 'en'
    }
  ]
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#f7f5f0" />
  <meta name="description" content={siteDescription} />
  <meta name="robots" content={robots} />
  <link rel="canonical" href={siteUrl} />
  <link rel="icon" href="/favicon.png" type="image/png" sizes="128x128" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Sparaton" />
  <meta property="og:title" content={siteTitle} />
  <meta property="og:description" content={siteDescription} />
  <meta property="og:url" content={siteUrl} />
  <meta property="og:image" content={siteUrl + 'og/sparaton.png'} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Sparaton. Independent manga production studio." />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={siteTitle} />
  <meta name="twitter:description" content={siteDescription} />
  <meta name="twitter:image" content={siteUrl + 'og/sparaton.png'} />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <title>{siteTitle}</title>
  <style is:global>
    :root {
      --paper:#f7f5f0;
      --panel:#efede6;
      --ink:#242421;
      --muted:#68675f;
      --line:#ddd9cf;
      --sans:Arial,Helvetica,sans-serif;
      --serif:Georgia,'Times New Roman',serif;
    }
    *,*::before,*::after{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{margin:0;background:var(--paper);color:var(--ink);font:16px/1.65 var(--sans);-webkit-font-smoothing:antialiased}
    img{max-width:100%;display:block}
    a{color:inherit}
    a:focus-visible{outline:2px solid var(--ink);outline-offset:5px}
    .wrap{width:min(calc(100% - 90px),1180px);margin:0 auto}
    .skip{position:absolute;top:-90px;left:20px;padding:12px 15px;background:white;z-index:20}
    .skip:focus{top:10px}
    .site-header{border-bottom:1px solid var(--line)}
    .header-inner{min-height:94px;display:flex;justify-content:space-between;align-items:center;gap:20px}
    .brand{display:inline-flex;align-items:center;gap:12px;text-decoration:none;white-space:nowrap}
    .brand img{width:40px;height:43px;object-fit:contain}
    .brand span{font:normal 29px/1 var(--serif);letter-spacing:-.05em}
    .main-nav{display:flex;gap:36px;align-items:center}
    .main-nav a{text-decoration:none;font-size:13px;color:#4f4d48;transition:color .15s}
    .main-nav a:hover,.subtle-link:hover,.profile-links a:hover{color:#000}
    .hero{display:grid;grid-template-columns:minmax(0,1.07fr) minmax(0,.93fr);gap:clamp(40px,7.6vw,108px);align-items:center;padding-top:105px;padding-bottom:112px;min-height:680px}
    h1,h2,h3,p{margin-top:0}
    h1,h2,h3{font-family:var(--serif);font-weight:400}
    .hero h1{font-size:clamp(68px,7.8vw,116px);line-height:.97;letter-spacing:-.072em;margin:0 0 30px}
    .hero h1 em{font-style:italic}
    .lead{font:normal clamp(23px,2.35vw,32px)/1.35 var(--serif);letter-spacing:-.025em;margin-bottom:19px}
    .intro{max-width:515px;color:var(--muted);line-height:1.83;margin-bottom:32px}
    .actions{display:flex;gap:26px;align-items:center;flex-wrap:wrap}
    .primary{display:inline-block;background:var(--ink);color:var(--paper);text-decoration:none;font-size:13px;padding:15px 21px;transition:background .15s}
    .primary:hover{background:#515149}
    .subtle-link{text-decoration:none;border-bottom:1px solid #99978d;padding:7px 0;font-size:13px;color:#4a4a43}
    .artwork{height:506px;background:var(--panel);border:1px solid var(--line);display:flex;flex-direction:column;justify-content:center;align-items:center;gap:37px;padding:43px 35px}
    .artwork img{width:min(68%,280px);max-height:310px;object-fit:contain}
    .artwork p{font:italic 27px/1.3 var(--serif);letter-spacing:-.028em;text-align:center;margin:0}
    .section{border-top:1px solid var(--line)}
    .section-inner{padding-top:110px;padding-bottom:112px}
    .about-layout{display:grid;grid-template-columns:1fr 1fr;align-items:start;gap:clamp(45px,6.5vw,110px)}
    .section h2{font-size:clamp(46px,5.1vw,74px);line-height:1.08;letter-spacing:-.052em;margin:0}
    .about-copy{padding-top:8px;max-width:525px}
    .about-copy p{color:var(--muted);margin-bottom:19px;line-height:1.86}
    .about-copy p:last-child{margin-bottom:0}
    .creators{background:var(--panel)}
    .creators-header{margin-bottom:42px}
    .creators h2{margin:0}
    .profiles{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}
    .profile{border:1px solid var(--line);background:var(--paper);padding:33px 34px 29px;display:flex;flex-direction:column;min-height:337px}
    .profile-head{display:flex;align-items:center;gap:24px;margin-bottom:24px}
    .portrait{width:92px;height:92px;background:#e5e1d7;border:1px solid #d4cfc4;display:flex;align-items:center;justify-content:center;flex:none;font:normal 34px var(--serif)}
    .profile h3{font-size:clamp(32px,3vw,43px);line-height:1;letter-spacing:-.055em;margin:0 0 9px}
    .role{font-size:13px;color:var(--muted);line-height:1.4;margin:0}
    .bio{font-size:15px;color:var(--muted);line-height:1.8;max-width:410px;margin:0 0 27px}
    .profile-links{display:flex;gap:23px;flex-wrap:wrap;padding-top:19px;border-top:1px solid var(--line);margin-top:auto}
    .profile-links a{font-size:13px;text-decoration:none;overflow-wrap:anywhere;border-bottom:1px solid #aaa69d}
    .contact-layout{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:start}
    .contact p{max-width:470px;color:var(--muted);line-height:1.85;margin:0 0 20px}
    .contact-email{font:normal clamp(24px,2.5vw,34px)/1.3 var(--serif);text-decoration:none;border-bottom:1px solid var(--ink);padding-bottom:6px;overflow-wrap:anywhere}
    .contact-email:hover{color:#000}
    .site-footer{border-top:1px solid var(--line)}
    .footer-inner{padding:29px 0;display:flex;align-items:center;justify-content:space-between;gap:20px}
    .footer-inner .brand img{width:27px;height:28px}
    .footer-inner .brand span{font-size:23px}
    .copyright{color:var(--muted);font-size:12px;margin:0}
    @media(max-width:900px){.wrap{width:min(calc(100% - 52px),1180px)}.hero{gap:36px;min-height:unset}.hero h1{font-size:clamp(58px,8vw,85px)}.artwork{height:400px}}
    @media(max-width:720px){.wrap{width:calc(100% - 36px)}.header-inner{min-height:76px}.brand img{width:32px;height:35px}.brand span{font-size:25px}.main-nav{gap:17px}.main-nav a{font-size:12px}.hero{grid-template-columns:1fr;gap:43px;padding-top:69px;padding-bottom:82px}.hero h1{font-size:clamp(58px,11.2vw,87px)}.artwork{height:350px}.artwork img{max-height:225px}.section-inner{padding-top:78px;padding-bottom:79px}.about-layout,.contact-layout{grid-template-columns:1fr;gap:28px}.section h2{font-size:clamp(43px,9vw,65px)}.profiles{grid-template-columns:1fr}.profile{min-height:unset}.footer-inner{gap:13px}}
    @media(max-width:430px){.main-nav a:first-child{display:none}.main-nav{gap:18px}.hero h1{font-size:clamp(50px,12.4vw,58px)}.lead{font-size:24px}.actions{gap:18px}.artwork{height:302px;padding:30px}.artwork img{max-height:180px}.artwork p{font-size:23px}.profile{padding:24px}.portrait{width:73px;height:73px;font-size:28px}.profile-head{gap:17px}.profile h3{font-size:35px}.contact-email{font-size:25px}}
    @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{transition:none!important}}
  </style>
</head>
<body>
  <a class="skip" href="#content">Skip to content</a>
  <header class="site-header">
    <div class="wrap header-inner">
      <a class="brand" href="#top" aria-label="Sparaton home"><img src="data:image/png;base64," alt="" /><span>Sparaton</span></a>
      <nav class="main-nav" aria-label="Main navigation"><a href="#about">About</a><a href="#creators">Creators</a><a href="#contact">Contact</a></nav>
    </div>
  </header>
  <main id="content">
    <section class="wrap hero" id="top" aria-labelledby="hero-title">
      <div>
        <h1 id="hero-title">Under <br /><em>construction.</em></h1>
        <p class="lead">The stories are already underway.</p>
        <p class="intro">Sparaton is an independent manga production studio creating original stories and worlds. We're building our website to share our work. Until it's ready, meet the people behind it.</p>
        <div class="actions"><a class="primary" href="#creators">Meet the creators</a><a class="subtle-link" href="mailto:support@sparaton.com">Contact us</a></div>
      </div>
      <div class="artwork"><img src="data:image/png;base64," alt="Sparaton emblem" /><p>Bringing worlds to life.</p></div>
    </section>
    <section class="section" id="about" aria-labelledby="about-title">
      <div class="wrap section-inner about-layout">
        <h2 id="about-title">Stories begin<br />with people.</h2>
        <div class="about-copy"><p>Our work begins with characters and ideas we can't leave alone. Through writing and collaboration, we turn them into original stories with their own worlds and points of view.</p></div>
      </div>
    </section>
    <section class="section creators" id="creators" aria-labelledby="creators-title">
      <div class="wrap section-inner">
        <div class="creators-header"><h2 id="creators-title">Meet the creators.</h2></div>
        <div class="profiles">
          {creators.map((person) => (
            <article class="profile">
              <div class="profile-head">
                <div class="portrait" aria-hidden="true">{person.initials}</div>
                <div><h3>{person.name}</h3><p class="role">{person.role}</p></div>
              </div>
              <p class="bio">{person.bio}</p>
              <div class="profile-links">
                {person.socials.map((social) => <a href={social.url}>{social.url.startsWith('mailto:') ? social.url.slice(7) : social.label}</a>)}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
    <section class="section contact" id="contact" aria-labelledby="contact-title">
      <div class="wrap section-inner contact-layout">
        <h2 id="contact-title">Get in touch.</h2>
        <div><p>Have a question about Sparaton or our work? We'd be happy to hear from you.</p><a class="contact-email" href="mailto:support@sparaton.com">support@sparaton.com</a></div>
      </div>
    </section>
  </main>
  <footer class="site-footer"><div class="wrap footer-inner"><a class="brand" href="#top" aria-label="Back to top"><img src="data:image/png;base64," alt="" /><span>Sparaton</span></a><p class="copyright">© 2026 Sparaton</p></div></footer>
</body>
</html>