---
import BaseLayout from '../layouts/BaseLayout.astro';
const selectedService = Astro.url.searchParams.get('service') ?? '';
---
<BaseLayout title="Contact | Sparaton Studios" description="Start a private inquiry with Sparaton Studios.">
  <section class="shell hero"><div><p class="eyebrow">Contact</p><h1>Tell us what you are trying to make.</h1></div><p class="lede">Your inquiry becomes a private Sparaton ticket. We verify your email before providing access to the conversation.</p></section>
  <section class="section"><div class="shell"><form class="form-grid" method="post" action="https://api.sparaton.com/v1/tickets"><input type="text" name="website" tabindex="-1" autocomplete="off" style="position:absolute;left:-10000px" aria-hidden="true" /><label>Name<input required name="name" maxlength="100" autocomplete="name" /></label><label>Email<input required type="email" name="email" maxlength="254" autocomplete="email" /></label><label>Inquiry type<select required name="inquiryType"><option value="commission">Commission</option><option value="collaboration">Collaboration</option><option value="project">Project question</option><option value="business">Business inquiry</option><option value="other">Other</option></select></label><label>Desired service<input name="service" value={selectedService} maxlength="120" /></label><label>Subject<input required name="subject" maxlength="180" /></label><label>Message<textarea required name="message" maxlength="12000"></textarea></label><button class="button" type="submit">Create private inquiry →</button><p class="muted">One verified email address may have one active ticket at a time. If you already have one, we will take you back to that conversation.</p></form></div></section>
</BaseLayout>
