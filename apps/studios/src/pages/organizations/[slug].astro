---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fetchContent, markdownToSafeHtml } from '../../lib/public-content';
const slug=Astro.params.slug??'';const result=await fetchContent('organizations',slug);if(result.status!==200)Astro.response.status=result.status===404?404:503;const item:any=result.item;const title=item?String(item.seo_title||`${item.name} · Sparaton Studios`):'Organization unavailable';const description=item?String(item.seo_description||item.description||''):'This organization could not be found.';const canonical=item?.canonical_url?String(item.canonical_url):`/organizations/${slug}`;const members=Array.isArray(item?.members)?item.members:[];const projects=Array.isArray(item?.projects)?item.projects:[];const links=Array.isArray(item?.links)?item.links:[];const schema=item?[{'@context':'https://schema.org','@type':'Organization',name:item.name,description:item.description,url:item.subdomain?`https://${item.subdomain}`:new URL(canonical,'https://sparaton.com').toString(),member:members.map((m:any)=>({'@type':'Person',name:m.display_name,url:`https://sparaton.com/people/${m.slug}`})),sameAs:links.map((l:any)=>l.url)},{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Sparaton Studios',item:'https://sparaton.com'},{'@type':'ListItem',position:2,name:'Organizations',item:'https://sparaton.com/organizations'},{'@type':'ListItem',position:3,name:item.name,item:new URL(canonical,'https://sparaton.com').toString()}]}]:[];
---
<BaseLayout title={title} description={description} canonical={canonical} ogImage={item?.social_image_url||'/og/sparaton.svg'} robots={item&&Number(item.robots_index)===0?'noindex,nofollow':'index,follow'} schemas={schema}><section class="shell hero"><div><p class="eyebrow">{item?.relationship_label||item?.kind||'Organization'}</p><h1>{item?.name??'Organization unavailable'}</h1></div><p class="lede">{item?.description??'The requested organization is unavailable.'}</p></section>{item&&<><section class="section"><div class="shell" style="display:grid;grid-template-columns:minmax(0,1.4fr) minmax(14rem,.6fr);gap:3rem"><article class="prose" set:html={markdownToSafeHtml(String(item.description||''))}></article><aside>{item.subdomain&&<p><a class="button" href={`https://${item.subdomain}`}>Visit subdomain</a></p>}{links.length>0&&<><p class="eyebrow">External links</p><ul>{links.map((l:any)=><li><a href={l.url}>{l.label}</a></li>)}</ul></>}</aside></div></section>{members.length>0&&<section class="section"><div class="shell"><div class="section-head"><p class="eyebrow">People</p><h2>Members</h2></div><div class="grid-3">{members.map((m:any)=><a class="card" href={`/people/${m.slug}`}><span class="eyebrow">{m.role_label}</span><h3>{m.display_name}</h3></a>)}</div></div></section>}{projects.length>0&&<section class="section"><div class="shell"><div class="section-head"><p class="eyebrow">Work</p><h2>Projects</h2></div><div class="grid-3">{projects.map((p:any)=><a class="card" href={`/projects/${p.slug}`}><span class="eyebrow">{p.status}</span><h3>{p.name}</h3><p>{p.summary}</p></a>)}</div></div></section>}</>}</BaseLayout>
