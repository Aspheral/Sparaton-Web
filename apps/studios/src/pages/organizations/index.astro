---
import BaseLayout from '../../layouts/BaseLayout.astro';
let organizations:any[]=[];let unavailable=false;try{const response=await fetch('https://api.sparaton.com/v1/content/organizations');if(response.ok){const data=await response.json() as {items:any[]};organizations=data.items}else unavailable=true}catch{unavailable=true}
---
<BaseLayout title="Organizations · Sparaton Studios" description="Studios, technical groups, and associated organizations within the Sparaton ecosystem." canonical="/organizations"><section class="shell hero"><div><p class="eyebrow">Ecosystem</p><h1>Organizations</h1></div><p class="lede">Studios and specialist groups retain their own identity while remaining legible as part of the wider Sparaton organization.</p></section><section class="section"><div class="shell">{unavailable&&<p class="muted">Organization publishing is temporarily unavailable.</p>}{!unavailable&&organizations.length===0&&<p class="muted">No public organizations are currently published.</p>}<div class="grid-3">{organizations.map(org=><a class="card" href={`/organizations/${org.slug}`}><span class="eyebrow">{org.relationship_label||org.kind}</span><h2 style="font-size:1.7rem">{org.name}</h2><p>{org.description}</p>{org.subdomain&&<p class="muted">{org.subdomain}</p>}</a>)}</div></div></section></BaseLayout>
