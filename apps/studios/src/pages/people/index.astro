---
import BaseLayout from '../../layouts/BaseLayout.astro';
let people:any[]=[];let unavailable=false;try{const response=await fetch('https://api.sparaton.com/v1/content/people');if(response.ok){const data=await response.json() as {items:any[]};people=data.items}else unavailable=true}catch{unavailable=true}
---
<BaseLayout title="People · Sparaton Studios" description="Creators and technical contributors working within the Sparaton ecosystem." canonical="/people"><section class="shell hero"><div><p class="eyebrow">People</p><h1>Creators, builders, collaborators.</h1></div><p class="lede">Sparaton is organized around the people doing the work. Public profiles connect disciplines, organizations, and projects without exposing private contact details.</p></section><section class="section"><div class="shell">{unavailable&&<p class="muted">People publishing is temporarily unavailable.</p>}{!unavailable&&people.length===0&&<p class="muted">No public creator profiles are currently published.</p>}<div class="grid-3">{people.map(person=><a class="card" href={`/people/${person.slug}`}><span class="eyebrow">{person.role_text||'Creator'}</span><h2 style="font-size:1.7rem">{person.display_name}</h2><p>{person.biography}</p>{person.availability&&<p class="muted">{person.availability}</p>}</a>)}</div></div></section></BaseLayout>
