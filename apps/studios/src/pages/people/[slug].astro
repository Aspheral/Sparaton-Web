---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fetchContent, markdownToSafeHtml } from '../../lib/public-content';
const slug=Astro.params.slug??'';const result=await fetchContent('people',slug);if(result.status!==200)Astro.response.status=result.status===404?404:503;const item:any=result.item;const title=item?String(item.seo_title||`${item.display_name} · Sparaton Studios`):'Person unavailable';const description=item?String(item.seo_description||item.biography||''):'This creator could not be found.';const canonical=item?.canonical_url?String(item.canonical_url):`/people/${slug}`;const memberships=Array.isArray(item?.memberships)?item.memberships:[];const projects=Array.isArray(item?.projects)?item.projects:[];const links=Array.isArray(item?.links)?item.links:[];const schema=item?[{'@context':'https://schema.org','@type':'Person',name:item.display_name,description:item.biography,url:new URL(canonical,'https://sparaton.com').toString(),affiliation:memberships.map((m:any)=>({'@type':'Organization',name:m.name,url:`https://sparaton.com/organizations/${m.slug}`})),sameAs:links.map((l:any)=>l.url)},{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Sparaton Studios',item:'https://sparaton.com'},{'@type':'ListItem',position:2,name:'People',item:'https://sparaton.com/people'},{'@type':'ListItem',position:3,name:item.display_name,item:new URL(canonical,'https://sparaton.com').toString()}]}]:[];
---
<BaseLayout title={title} description={description} canonical={canonical} ogImage={item?.social_image_url||'/og/sparaton.svg'} robots={item&&Number(item.robots_index)===0?'noindex,nofollow':'index,follow'} schemas={schema}><section class="shell hero"><div><p class="eyebrow">Creator</p><h1>{item?.display_name??'Person unavailable'}</h1></div><div><p class="lede">{item?.role_text||item?.biography||'The requested creator is unavailable.'}</p>{item?.availability&&<p class="muted">Availability: {item.availability}</p>}</div></section>{item&&<><section class="section"><div class="shell" style="display:grid;grid-template-columns:minmax(0,1.4fr) minmax(14rem,.6fr);gap:3rem"><article class="prose" set:html={markdownToSafeHtml(String(item.biography||''))}></article><aside>{memberships.length>0&&<><p class="eyebrow">Organizations</p><ul>{memberships.map((m:any)=><li><a href={`/organizations/${m.slug}`}>{m.name}</a> · {m.role_label}</li>)}</ul></>}{links.length>0&&<><p class="eyebrow">Elsewhere</p><ul>{links.map((l:any)=><li><a href={l.url}>{l.label}</a></li>)}</ul></>}</aside></div></section>{projects.length>0&&<section class="section"><div class="shell"><div class="section-head"><p class="eyebrow">Work</p><h2>Projects</h2></div><div class="grid-3">{projects.map((p:any)=><a class="card" href={`/projects/${p.slug}`}><span class="eyebrow">{p.credit_label}</span><h3>{p.name}</h3><p>{p.summary}</p></a>)}</div></div></section>}</>}</BaseLayout>
