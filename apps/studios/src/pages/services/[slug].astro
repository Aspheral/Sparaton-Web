---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fetchContent, markdownToSafeHtml } from '../../lib/public-content';
const slug=Astro.params.slug??'';const result=await fetchContent('services',slug);if(result.status!==200)Astro.response.status=result.status===404?404:503;const item:any=result.item;const title=item?String(item.seo_title||`${item.name} · Sparaton Studios`):'Service unavailable';const description=item?String(item.seo_description||item.summary||''):'This service could not be found.';const canonical=item?.canonical_url?String(item.canonical_url):`/services/${slug}`;const schema=item?[{'@context':'https://schema.org','@type':'Service',name:item.name,description:item.summary,provider:{'@type':'Organization',name:item.organization_name||'Sparaton Studios',url:item.organization_slug?`https://sparaton.com/organizations/${item.organization_slug}`:'https://sparaton.com'},url:new URL(canonical,'https://sparaton.com').toString()},{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Sparaton Studios',item:'https://sparaton.com'},{'@type':'ListItem',position:2,name:'Services',item:'https://sparaton.com/services'},{'@type':'ListItem',position:3,name:item.name,item:new URL(canonical,'https://sparaton.com').toString()}]}]:[];
---
<BaseLayout title={title} description={description} canonical={canonical} ogImage={item?.social_image_url||'/og/sparaton.svg'} robots={item&&Number(item.robots_index)===0?'noindex,nofollow':'index,follow'} schemas={schema}><section class="shell hero"><div><p class="eyebrow">{item?.category||'Service'}</p><h1>{item?.name??'Service unavailable'}</h1></div><p class="lede">{item?.summary??'The requested service is unavailable.'}</p></section>{item&&<section class="section"><div class="shell" style="display:grid;grid-template-columns:minmax(0,1.4fr) minmax(14rem,.6fr);gap:3rem"><article class="prose" set:html={markdownToSafeHtml(String(item.body_markdown||item.summary||''))}></article><aside><dl style="display:grid;grid-template-columns:auto 1fr;gap:.5rem 1rem">{item.scope_text&&<><dt>Scope</dt><dd>{item.scope_text}</dd></>}{item.provider_text&&<><dt>Provider</dt><dd>{item.provider_text}</dd></>}{item.availability&&<><dt>Availability</dt><dd>{item.availability}</dd></>}{item.pricing_model&&<><dt>Pricing</dt><dd>{item.pricing_model}</dd></>}</dl><p style="margin-top:1.5rem"><a class="button" href={`/contact?service=${encodeURIComponent(item.slug)}`}>{item.inquiry_cta||'Request a quote'}</a></p></aside></div></section>}</BaseLayout>
