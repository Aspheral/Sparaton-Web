import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Accessibility | Sparaton Studios"><section class="shell hero"><div><p class="eyebrow">Accessibility</p><h1>The interface should not require a particular body or input method.</h1></div><p class="lede">Sparaton targets WCAG 2.2 AA and treats keyboard, contrast, motion preference, semantics, and readable error states as product requirements.</p></section><section class="section"><article class="shell prose"><h2>Current approach</h2><p>Public navigation includes skip links and visible focus states. Forms use programmatic labels and server-side validation. Motion respects reduced-motion preferences. Light and dark themes are designed separately rather than mechanically inverted.</p><h2>Feedback</h2><p>If an accessibility barrier prevents you from using the site, use the Contact route and select an accessibility or general inquiry. A public accessibility contact address can be added once Sparaton confirms one.</p></article></section></BaseLayout>
