---
import '@sparaton/ui/styles.css';
import brand from '@sparaton/ui/brand.svg?raw';
const { title='ILMP | Lattice Forge', description='Research and development around Intelligent Layered Media Packing.' }=Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><link rel="canonical" href={Astro.url}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><title>{title}</title><script is:inline>{`(()=>{try{const s=localStorage.getItem('sparaton-theme');const d=matchMedia('(prefers-color-scheme: dark)').matches;document.documentElement.dataset.theme=(s==='light'||s==='dark')?s:(d?'dark':'light')}catch{}})()`}</script></head><body><a class="skip-link" href="#content">Skip to content</a><header class="shell site-header"><a class="brand" href="/"><span set:html={brand}></span><span>ILMP / LATTICE FORGE</span></a><nav class="nav"><a href="/#models">Models</a><a href="/#research">Research</a><a href="/#status">Status</a><a class="always" href="https://sparaton.com/contact?project=ILMP">Contact</a><button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle color theme">◐</button></nav></header><main id="content"><slot/></main><footer><div class="shell footer-grid"><div><a class="brand" href="/"><span set:html={brand}></span><span>LATTICE FORGE</span></a><p class="muted">ILMP media technology research within the Sparaton ecosystem.</p></div><div><strong>ILMP</strong><ul><li><a href="/#models">Models</a></li><li><a href="/#research">Research</a></li></ul></div><div><strong>Sparaton</strong><ul><li><a href="https://sparaton.com">Sparaton Studios</a></li><li><a href="https://aspheral.sparaton.com">Aspheral Softworks</a></li></ul></div><div><strong>Contact</strong><ul><li><a href="https://sparaton.com/contact?project=ILMP">Project inquiry</a></li></ul></div></div></footer><script is:inline>{`document.getElementById('theme-toggle')?.addEventListener('click',()=>{const n=document.documentElement.dataset.theme==='dark'?'light':'dark';document.documentElement.dataset.theme=n;localStorage.setItem('sparaton-theme',n)})`}</script></body></html>
