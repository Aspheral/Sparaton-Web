---
import '@sparaton/ui/styles.css';
const { publicId } = Astro.params;
if (!publicId) return Astro.redirect('/');
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow,noarchive"/><meta name="referrer" content="no-referrer"/><title>Ticket · Sparaton Admin</title><script is:inline>
(()=>{try{const saved=localStorage.getItem('sparaton-theme');const dark=matchMedia('(prefers-color-scheme: dark)').matches;document.documentElement.dataset.theme=saved==='light'||saved==='dark'?saved:dark?'dark':'light'}catch{}})();
</script></head><body data-ticket-id={publicId}><a class="skip-link" href="#content">Skip to content</a><header class="shell site-header"><a href="/" style="font-weight:700;letter-spacing:.1em">SPARATON / ADMIN</a><nav class="nav"><a href="/#tickets">Inbox</a><span id="presence" class="muted" aria-live="polite">Connecting…</span></nav></header><main id="content"><section class="shell" style="padding-block:3rem 1.5rem"><p class="eyebrow">Ticket workspace</p><div style="display:flex;gap:1rem;align-items:end;justify-content:space-between;flex-wrap:wrap"><div><h1 id="subject" style="font-size:clamp(2rem,5vw,4.75rem);max-width:18ch">Loading ticket…</h1><p id="requester" class="lede"></p></div><div style="display:flex;gap:.5rem;flex-wrap:wrap"><span class="button" id="status-badge" aria-label="Ticket status">…</span><span class="button" id="priority-badge" aria-label="Ticket priority">…</span></div></div></section><section class="shell" style="display:grid;grid-template-columns:minmax(0,1.6fr) minmax(18rem,.75fr);gap:1.5rem;padding-bottom:4rem"><div><div id="timeline" style="display:grid;gap:.75rem" aria-live="polite"></div><form id="reply-form" class="card" style="margin-top:1rem"><label>Reply to client<textarea name="body" required maxlength="12000" rows="5"></textarea></label><div style="display:flex;justify-content:space-between;gap:1rem;align-items:center;flex-wrap:wrap"><span class="muted">Replies are part of the canonical ticket timeline.</span><button class="button" type="submit">Send reply</button></div></form><p id="workspace-message" role="status" class="muted"></p></div><aside style="display:grid;gap:1rem;align-content:start"><section class="card"><h2 style="font-size:1.4rem">Routing</h2><form id="assignment-form"><label>Assigned staff<input type="email" name="staffEmail" placeholder="staff@sparaton.com" required/></label><button class="button" type="submit">Assign / transfer</button></form><form id="state-form" style="margin-top:1rem"><label>Status<select name="status"><option>new</option><option>open</option><option>assigned</option><option>awaiting_staff</option><option>awaiting_client</option><option>resolved</option><option>closed</option><option>archived</option></select></label><label>Priority<select name="priority"><option>low</option><option>normal</option><option>high</option><option>urgent</option></select></label><button class="button" type="submit">Update ticket</button></form></section><section class="card"><h2 style="font-size:1.4rem">Attachments</h2><p class="muted">Private R2-backed files. Internal attachments are never exposed through the client route.</p><form id="attachment-form"><label>File<input type="file" name="file" required accept=".pdf,.png,.jpg,.jpeg,.gif,.webp,.txt,.md,application/pdf,image/png,image/jpeg,image/gif,image/webp,text/plain,text/markdown"/></label><label>Visibility<select name="visibility"><option value="client">Client-visible</option><option value="internal">Internal staff only</option></select></label><button class="button" type="submit">Upload</button></form><div id="attachments" style="display:grid;gap:.5rem;margin-top:1rem"></div></section><section class="card"><h2 style="font-size:1.4rem">Internal notes</h2><form id="note-form"><label>Staff-only note<textarea name="body" required maxlength="12000" rows="4"></textarea></label><button class="button" type="submit">Add note</button></form><div id="notes" style="display:grid;gap:.6rem;margin-top:1rem"></div></section><section class="card"><h2 style="font-size:1.4rem">Tags</h2><form id="tag-form" style="display:flex;gap:.5rem"><input name="tag" required maxlength="48" placeholder="commission"/><button class="button" type="submit">Add</button></form><div id="tags" style="display:flex;gap:.4rem;flex-wrap:wrap;margin-top:.75rem"></div></section><section class="card"><h2 style="font-size:1.4rem">Requester & context</h2><dl id="context" style="display:grid;grid-template-columns:auto 1fr;gap:.4rem .8rem"></dl></section><section class="card"><h2 style="font-size:1.4rem">History</h2><details open><summary>Status & assignments</summary><div id="history" class="muted" style="display:grid;gap:.5rem;margin-top:.75rem"></div></details><details><summary>Audit</summary><div id="audit" class="muted" style="display:grid;gap:.5rem;margin-top:.75rem"></div></details><details><summary>Email delivery</summary><div id="notifications" class="muted" style="display:grid;gap:.5rem;margin-top:.75rem"></div></details></section></aside></section></main><style>@media(max-width:850px){main .shell[style*="grid-template-columns"]{grid-template-columns:1fr!important}}.timeline-item{border:1px solid var(--line);padding:1rem 1.1rem;background:var(--surface)}.timeline-item.staff{margin-left:8%;border-left:3px solid var(--accent)}.timeline-item.client{margin-right:8%}.note{border-left:3px solid var(--line);padding:.6rem .8rem;background:var(--surface-2)}dl dt{font-weight:700}dl dd{margin:0;overflow-wrap:anywhere}</style><script is:inline src="/ticket-workspace.js"></script></body></html>
