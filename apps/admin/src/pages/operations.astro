---
import '@sparaton/ui/styles.css';
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow,noarchive"/><meta name="referrer" content="no-referrer"/><title>Content Operations · Sparaton Admin</title></head><body><a class="skip-link" href="#content">Skip to content</a><header class="shell site-header"><a href="/" style="font-weight:700;letter-spacing:.1em">SPARATON / ADMIN</a><nav class="nav"><a href="/">Overview</a><a href="/content">Content</a><a href="/operations" aria-current="page">Operations</a></nav></header><main id="content"><section class="shell hero" style="padding-block:4rem 2rem"><div><p class="eyebrow">Content operations</p><h1 style="font-size:clamp(3rem,7vw,6rem)">Relationships, media & governance</h1></div><p class="lede">Operational editors for normalized relationships, public media, staff reply templates, privacy requests, retention policy, and audit evidence.</p></section>
<section class="shell ops-grid" style="padding-bottom:5rem">
  <section class="card span-2" id="relationships"><div class="section-head"><p class="eyebrow">CMS graph</p><h2>Relationships</h2></div><div class="toolbar"><label>Content type<select id="relationship-kind"><option value="people">Person</option><option value="organizations">Organization</option><option value="projects">Project</option></select></label><label>Record<select id="relationship-entity"><option value="">Select a record…</option></select></label></div><p class="muted">Manage credits, memberships, associated organizations/projects, and external/social links. Duplicate relationship keys are rejected before persistence.</p><form id="relationship-form"><div id="relationship-groups"></div><button class="button" type="submit">Save relationships</button></form>
  </section>
  <section class="card span-2" id="media"><div class="section-head"><p class="eyebrow">Public R2</p><h2>Media library</h2></div><form id="media-upload" class="editor"><label>Image<input name="file" type="file" required accept="image/png,image/jpeg,image/gif,image/webp,.png,.jpg,.jpeg,.gif,.webp"/></label><label>Alt text<input name="altText" maxlength="500"/></label><label>Caption<input name="caption" maxlength="1000"/></label><label>Focal X (0–1)<input name="focalX" type="number" min="0" max="1" step="0.01"/></label><label>Focal Y (0–1)<input name="focalY" type="number" min="0" max="1" step="0.01"/></label><button class="button" type="submit">Upload image</button></form><div class="toolbar"><label>Search<input id="media-search" placeholder="filename, alt text, caption"/></label><label>Type<select id="media-mime"><option value="">All images</option><option value="image/png">PNG</option><option value="image/jpeg">JPEG</option><option value="image/gif">GIF</option><option value="image/webp">WebP</option></select></label><button class="button" id="media-refresh" type="button">Refresh</button></div><div id="media-list" class="media-list"></div></section>
  <section class="card" id="responses"><div class="section-head"><p class="eyebrow">Support writing</p><h2>Canned responses</h2></div><form id="canned-form" class="stack"><input name="id" type="hidden"/><label>Title<input name="title" required maxlength="160"/></label><label>Category<input name="category" value="general" maxlength="80"/></label><label>Body<textarea name="body" required rows="7" maxlength="12000"></textarea></label><label>Visibility<select name="visibility"><option value="staff">All staff</option><option value="organization">Organization</option><option value="team">Team</option></select></label><label>Organization ID<input name="organizationId" maxlength="120"/></label><label>Team<input name="team" maxlength="120"/></label><label>Sort order<input name="sortOrder" type="number" value="0"/></label><label><input name="active" type="checkbox" checked/> Active</label><button class="button" type="submit">Save template</button></form><div id="canned-list" class="records"></div></section>
  <section class="card" id="privacy"><div class="section-head"><p class="eyebrow">Privacy operations</p><h2>Requester data</h2></div><form id="privacy-lookup" class="stack"><label>Verified requester email<input name="email" type="email" required/></label><button class="button" type="submit">Find requester</button></form><div id="privacy-result" class="muted"></div><div class="toolbar"><button class="button" id="privacy-export" type="button">Export data</button><button class="button" id="privacy-close-sessions" type="button">Close sessions</button><button class="button" id="privacy-cleanup" type="button">Clean expired records</button></div><details><summary>Anonymize requester</summary><p class="muted">Disabled unless the owner/legal retention setting explicitly permits it. Active tickets block anonymization. Canonical message bodies and security audit evidence are retained.</p><form id="privacy-anonymize" class="stack"><label>Email<input name="email" type="email" required/></label><label>Type the email again<input name="confirmEmail" type="email" required/></label><button class="button" type="submit">Anonymize permitted identifiers</button></form></details></section>
  <section class="card" id="retention"><div class="section-head"><p class="eyebrow">Policy configuration</p><h2>Retention</h2></div><p class="muted">No legal periods are invented. Blank values mean no automatic policy has been approved.</p><form id="retention-form" class="stack"><label>Verification days<input name="verificationDays" type="number" min="0"/></label><label>Session days after expiry<input name="sessionDaysAfterExpiry" type="number" min="0"/></label><label>Attachment days after closure<input name="attachmentDaysAfterClosure" type="number" min="0"/></label><label>Audit days<input name="auditDays" type="number" min="0"/></label><label><input name="allowAnonymization" type="checkbox"/> Permit requester anonymization</label><label><input name="legalConfirmed" type="checkbox"/> Owner/legal retention policy confirmed</label><button class="button" type="submit">Save retention policy</button></form></section>
  <section class="card span-2" id="audit"><div class="section-head"><p class="eyebrow">Security evidence</p><h2>Audit log</h2></div><form id="audit-filter" class="toolbar"><label>Action<input name="action" placeholder="cms.project"/></label><label>Actor<input name="actor" type="search"/></label><label>Target<input name="target" type="search"/></label><label>Search<input name="q" type="search"/></label><button class="button">Filter</button></form><div id="audit-list" class="audit-list"></div></section>
  <p id="ops-message" role="status" aria-live="polite" class="muted span-2"></p>
</section></main><style>.ops-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.span-2{grid-column:1/-1}.toolbar{display:flex;gap:.75rem;align-items:end;flex-wrap:wrap}.toolbar label{display:grid;gap:.3rem;flex:1;min-width:12rem}.stack{display:grid;gap:.75rem}.stack label{display:grid;gap:.3rem}.rel-group{border-top:1px solid var(--line);padding-top:1rem;margin-top:1rem}.rel-group-head{display:flex;justify-content:space-between;gap:1rem;align-items:center}.rel-row{display:grid;grid-template-columns:minmax(10rem,1.4fr) repeat(3,minmax(7rem,1fr)) auto;gap:.5rem;align-items:end;padding:.5rem 0}.rel-row label{display:grid;gap:.25rem}.media-list{display:grid;grid-template-columns:repeat(auto-fill,minmax(17rem,1fr));gap:1rem;margin-top:1rem}.media-item img{width:100%;aspect-ratio:16/10;object-fit:contain;background:var(--surface-2);border:1px solid var(--line)}.media-meta{display:grid;gap:.4rem}.records,.audit-list{display:grid;gap:.45rem;margin-top:1rem}.record,.audit-row{border-top:1px solid var(--line);padding:.65rem 0}.record-actions{display:flex;gap:.4rem;flex-wrap:wrap}.editor{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem}.editor label{display:grid;gap:.3rem}.editor button{align-self:end}@media(max-width:900px){.ops-grid{grid-template-columns:1fr}.span-2{grid-column:auto}.rel-row{grid-template-columns:1fr 1fr}.rel-row .remove{grid-column:1/-1}.editor{grid-template-columns:1fr}}</style><script is:inline src="/operations.js"></script></body></html>
