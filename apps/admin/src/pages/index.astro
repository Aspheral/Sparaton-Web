---
import '@sparaton/ui/styles.css';
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow,noarchive"/><title>Sparaton Admin</title><script is:inline>{`(()=>{try{const s=localStorage.getItem('sparaton-theme');const d=matchMedia('(prefers-color-scheme: dark)').matches;document.documentElement.dataset.theme=(s==='light'||s==='dark')?s:(d?'dark':'light')}catch{}})()`}</script></head><body><a class="skip-link" href="#content">Skip to content</a><header class="shell site-header"><strong style="letter-spacing:.1em">SPARATON / ADMIN</strong><nav class="nav"><a href="#tickets">Tickets</a><a href="#publishing">Publishing</a><a href="#traffic">Site Traffic</a></nav></header><main id="content"><section class="shell hero" style="padding-block:4rem"><div><p class="eyebrow">Operations</p><h1 style="font-size:clamp(3.5rem,8vw,7rem)">Admin workspace</h1></div><p class="lede">Live operational data only. If an integration is missing, this panel says so instead of drawing decorative graphs.</p></section><section class="section"><div class="shell"><div class="metric-grid"><div class="metric"><span class="eyebrow">Open tickets</span><strong id="open-count">…</strong></div><div class="metric"><span class="eyebrow">Waiting on staff</span><strong id="waiting-count">…</strong></div><div class="metric"><span class="eyebrow">Analytics</span><strong id="analytics-state" style="font-size:1.2rem">Checking</strong></div></div></div></section><section class="section" id="tickets"><div class="shell"><div class="section-head"><p class="eyebrow">Tickets</p><h2>Inbox</h2></div><div id="ticket-list" style="display:grid;gap:1px;background:var(--line);border:1px solid var(--line)"></div></div></section><section class="section" id="publishing"><div class="shell"><div class="section-head"><p class="eyebrow">Publishing</p><h2>Create or update structured content.</h2></div><div class="grid-3"><form id="project-form" class="card"><h3>Project</h3><label>Slug<input name="slug" required pattern="[a-z0-9-]+"/></label><label>Name<input name="name" required/></label><label>Summary<textarea name="summary" required></textarea></label><label>Status<select name="status"><option>in-development</option><option>active</option><option>stable</option><option>research</option><option>archived</option></select></label><label><input type="checkbox" name="published"/> Published</label><button class="button" type="submit">Save project</button></form><form id="post-form" class="card"><h3>Post</h3><label>Slug<input name="slug" required pattern="[a-z0-9-]+"/></label><label>Title<input name="title" required/></label><label>Summary<textarea name="summary" required></textarea></label><label>Body (Markdown)<textarea name="bodyMarkdown" required></textarea></label><label>Type<select name="type"><option>announcement</option><option>project-update</option><option>engineering-note</option><option>release</option><option>research</option><option>studio-news</option><option>creator-update</option></select></label><label><input type="checkbox" name="published"/> Published</label><button class="button" type="submit">Save post</button></form><article class="card" id="traffic"><h3>Site Traffic</h3><p class="muted" id="traffic-copy">Loading configuration state…</p></article></div><p id="admin-message" role="status" class="muted"></p></div></section></main><script is:inline src="/admin.js"></script></body></html>
