---
import '@sparaton/ui/styles.css';
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow,noarchive"/><meta name="referrer" content="no-referrer"/><title>Content · Sparaton Admin</title><script is:inline>(()=>{try{const s=localStorage.getItem('sparaton-theme');const d=matchMedia('(prefers-color-scheme: dark)').matches;document.documentElement.dataset.theme=s==='light'||s==='dark'?s:d?'dark':'light'}catch{}})();</script></head><body><a class="skip-link" href="#content">Skip to content</a><header class="shell site-header"><a href="/" style="font-weight:700;letter-spacing:.1em">SPARATON / ADMIN</a><nav class="nav"><a href="/#tickets">Tickets</a><a href="/content">Content</a></nav></header><main id="content"><section class="shell hero" style="padding-block:4rem 2rem"><div><p class="eyebrow">Content management</p><h1 style="font-size:clamp(3rem,7vw,6rem)">Structured publishing</h1></div><p class="lede">People, organizations, services, projects, metrics, posts, SEO, and site settings all persist to D1. Drafts remain private.</p></section><section class="shell" style="padding-bottom:5rem"><div class="content-grid"><nav class="card content-nav" aria-label="Content sections"><button data-section="people">People</button><button data-section="organizations">Organizations</button><button data-section="services">Services</button><button data-section="projects">Projects</button><button data-section="metrics">Project metrics</button><button data-section="posts">Posts</button><button data-section="settings">Settings</button></nav><div><section class="cms-panel" data-panel="people"><h2>People</h2><form data-form="people" class="editor"><input type="hidden" name="id"/><label>Display name<input name="displayName" required/></label><label>Slug<input name="slug" required pattern="[a-z0-9-]+"/></label><label>Role<input name="role"/></label><label>Biography<textarea name="biography" rows="6"></textarea></label><label>Areas of work, comma separated<input name="areas"/></label><label>Profile image URL<input name="profileImageUrl" type="url"/></label><label>Availability<input name="availability"/></label><label>Contact route<input name="contactRoute"/></label><label>Sort order<input name="sortOrder" type="number" value="0"/></label><label><input name="isPublic" type="checkbox" checked/> Public</label><fieldset><legend>SEO</legend><label>SEO title<input name="seoTitle"/></label><label>Description<textarea name="seoDescription"></textarea></label><label>Canonical URL<input name="canonicalUrl" type="url"/></label><label>Social title<input name="socialTitle"/></label><label>Social description<textarea name="socialDescription"></textarea></label><label>Social image URL<input name="socialImageUrl" type="url"/></label><label><input name="robotsIndex" type="checkbox" checked/> Allow indexing</label></fieldset><button class="button">Save person</button></form><div data-list="people" class="records"></div></section><section class="cms-panel" data-panel="organizations" hidden><h2>Organizations</h2><form data-form="organizations" class="editor"><input type="hidden" name="id"/><label>Name<input name="name" required/></label><label>Slug<input name="slug" required pattern="[a-z0-9-]+"/></label><label>Kind<input name="kind" value="organization"/></label><label>Relationship to Sparaton<input name="relationshipLabel"/></label><label>Description<textarea name="description" rows="6"></textarea></label><label>Subdomain<input name="subdomain" placeholder="aspheral.sparaton.com"/></label><label>Logo URL<input name="logoUrl" type="url"/></label><label>Contact route<input name="contactRoute"/></label><label>Sort order<input name="sortOrder" type="number" value="0"/></label><label><input name="isPublic" type="checkbox" checked/> Public</label><div data-seo></div><button class="button">Save organization</button></form><div data-list="organizations" class="records"></div></section><section class="cms-panel" data-panel="services" hidden><h2>Services</h2><form data-form="services" class="editor"><input type="hidden" name="id"/><label>Title<input name="name" required/></label><label>Slug<input name="slug" required pattern="[a-z0-9-]+"/></label><label>Category<input name="category"/></label><label>Summary<textarea name="summary" required></textarea></label><label>Long description (Markdown)<textarea name="bodyMarkdown" rows="6"></textarea></label><label>Scope<textarea name="scope"></textarea></label><label>Provider / team<input name="provider"/></label><label>Organization ID<input name="organizationId"/></label><label>Availability<input name="availability"/></label><label>Pricing text<input name="pricingText" placeholder="Request a quote"/></label><label>Inquiry CTA<input name="inquiryCta" value="Request a quote"/></label><label>Sort order<input name="sortOrder" type="number" value="0"/></label><label><input name="isPublic" type="checkbox" checked/> Public</label><div data-seo></div><button class="button">Save service</button></form><div data-list="services" class="records"></div></section><section class="cms-panel" data-panel="projects" hidden><h2>Projects</h2><form data-form="projects" class="editor"><input type="hidden" name="id"/><label>Name<input name="name" required/></label><label>Slug<input name="slug" required pattern="[a-z0-9-]+"/></label><label>Organization ID<input name="organizationId"/></label><label>Status<input name="status" value="in-development" required/></label><label>Summary<textarea name="summary" required></textarea></label><label>Body (Markdown)<textarea name="bodyMarkdown" rows="8"></textarea></label><label>Repository URL<input name="repositoryUrl" type="url"/></label><label>Release URL<input name="releaseUrl" type="url"/></label><label>Documentation URL<input name="documentationUrl" type="url"/></label><div class="checks"><label><input name="featured" type="checkbox"/> Featured</label><label><input name="highlighted" type="checkbox"/> Highlighted</label><label><input name="pinned" type="checkbox"/> Pinned</label><label><input name="experimental" type="checkbox"/> Experimental</label><label><input name="published" type="checkbox"/> Published</label></div><div data-seo></div><button class="button">Save project</button></form><div data-list="projects" class="records"></div></section><section class="cms-panel" data-panel="metrics" hidden><h2>Project metrics</h2><form data-form="metrics" class="editor"><label>Project ID<input name="projectId" required/></label><label>Metric key<input name="key" required pattern="[a-z0-9-]+"/></label><label>Label<input name="label" required/></label><label>Value<input name="value" required/></label><label>Qualifier<textarea name="qualifier"></textarea></label><label>Status<select name="status"><option>provisional</option><option>measured</option><option>historical</option><option>target</option></select></label><label>Source<input name="source"/></label><label>Source URL<input name="sourceUrl" type="url"/></label><label>Measured at<input name="measuredAt" type="datetime-local"/></label><button class="button">Save metric</button></form></section><section class="cms-panel" data-panel="posts" hidden><h2>Posts</h2><form data-form="posts" class="editor"><input type="hidden" name="id"/><label>Title<input name="title" required/></label><label>Slug<input name="slug" required pattern="[a-z0-9-]+"/></label><label>Type<select name="type"><option>announcement</option><option>project-update</option><option>engineering-note</option><option>release</option><option>research</option><option>studio-news</option><option>creator-update</option></select></label><label>Organization ID<input name="organizationId"/></label><label>Project ID<input name="projectId"/></label><label>Summary<textarea name="summary" required></textarea></label><label>Body (Markdown)<textarea name="bodyMarkdown" rows="12" required></textarea></label><label><input name="published" type="checkbox"/> Published</label><div data-seo></div><button class="button">Save post</button></form><div data-list="posts" class="records"></div></section><section class="cms-panel" data-panel="settings" hidden><h2>Settings</h2><form data-form="settings" class="editor"><label>Key<input name="key" required pattern="[a-z0-9._-]+"/></label><label>JSON value<textarea name="value" rows="8" required>{}</textarea></label><button class="button">Save setting</button></form><div data-list="settings" class="records"></div></section><p id="cms-message" class="muted" role="status"></p></div></div></section></main><template id="seo-template"><fieldset><legend>SEO & social</legend><label>SEO title<input name="seoTitle"/></label><label>Description<textarea name="seoDescription"></textarea></label><label>Canonical URL<input name="canonicalUrl" type="url"/></label><label>Social title<input name="socialTitle"/></label><label>Social description<textarea name="socialDescription"></textarea></label><label>Social image URL<input name="socialImageUrl" type="url"/></label><label><input name="robotsIndex" type="checkbox" checked/> Allow indexing</label></fieldset></template><style>.content-grid{display:grid;grid-template-columns:14rem minmax(0,1fr);gap:2rem}.content-nav{display:grid;gap:.35rem;align-content:start;position:sticky;top:1rem;height:max-content}.content-nav button{font:inherit;text-align:left;background:none;border:0;color:inherit;padding:.65rem;cursor:pointer}.content-nav button[aria-current=true]{background:var(--surface-2);font-weight:700}.cms-panel>h2{font-size:clamp(2rem,4vw,3.5rem)}.editor{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;border-top:1px solid var(--line);padding-top:1.25rem}.editor>label,.editor>fieldset{display:grid;gap:.35rem}.editor textarea,.editor fieldset,.editor .checks,.editor button{grid-column:1/-1}.editor fieldset{grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;border:1px solid var(--line);padding:1rem}.records{display:grid;gap:.5rem;margin-top:1.5rem}.record{display:flex;justify-content:space-between;gap:1rem;align-items:center;border-top:1px solid var(--line);padding:.8rem 0}.record-actions{display:flex;gap:.35rem}.checks{display:flex;gap:1rem;flex-wrap:wrap}@media(max-width:800px){.content-grid{grid-template-columns:1fr}.content-nav{position:static;grid-template-columns:repeat(2,1fr)}.editor,.editor fieldset{grid-template-columns:1fr}}</style><script is:inline src="/content-admin.js"></script></body></html>
